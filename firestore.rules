rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.matches('^[a-zA-Z0-9_-]{1,64}$');
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['playerName', 'hero', 'mode', 'score', 'coins', 'timeSeconds', 'bossDefeated', 'createdAt']) &&
        data.keys().hasOnly(['playerName', 'hero', 'mode', 'score', 'coins', 'timeSeconds', 'bossDefeated', 'createdAt']) &&
        data.playerName is string && data.playerName.size() >= 1 && data.playerName.size() <= 32 &&
        data.hero is string && data.hero.size() >= 1 && data.hero.size() <= 20 &&
        data.mode in ['campaign', 'survival'] &&
        data.score is number && data.score >= 0 && data.score <= 10000000 &&
        data.coins is number && data.coins >= 0 && data.coins <= 100000 &&
        data.timeSeconds is number && data.timeSeconds >= 0 &&
        data.bossDefeated is bool &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId', 'displayName']) &&
        data.userId == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 32 &&
        (!('bestScore' in data) || (data.bestScore is number && data.bestScore >= 0)) &&
        (!('gamesPlayed' in data) || (data.gamesPlayed is number && data.gamesPlayed >= 0));
    }

    function isValidAccountProgressionDocument(data) {
      let profile = data.profile;
      let ranks = profile.talentRanks;
      let stats = profile.stats;
      return data.keys().hasAll(['schemaVersion', 'profile', 'updatedAt']) &&
        data.keys().hasOnly(['schemaVersion', 'profile', 'updatedAt']) &&
        data.schemaVersion == 1 &&
        data.updatedAt is int && data.updatedAt >= 0 &&
        profile is map &&
        profile.keys().hasAll(['version', 'level', 'xp', 'talentRanks', 'stats']) &&
        profile.keys().hasOnly(['version', 'level', 'xp', 'talentRanks', 'stats']) &&
        profile.version == 1 &&
        profile.level is int && profile.level >= 1 && profile.level <= 37 &&
        profile.xp is int && profile.xp >= 0 && profile.xp <= 10000 &&
        ranks is map && ranks.size() <= 12 &&
        ranks.keys().hasOnly([
          'weapon_training', 'ability_calibration', 'rapid_protocol',
          'reinforced_vest', 'impact_bracing', 'last_reserve',
          'light_footwork', 'dynamic_stride', 'jump_technique',
          'combat_analysis', 'cooldown_planning', 'field_intelligence'
        ]) &&
        (!('weapon_training' in ranks) || (ranks.weapon_training is int && ranks.weapon_training >= 0 && ranks.weapon_training <= 3)) &&
        (!('ability_calibration' in ranks) || (ranks.ability_calibration is int && ranks.ability_calibration >= 0 && ranks.ability_calibration <= 3)) &&
        (!('rapid_protocol' in ranks) || (ranks.rapid_protocol is int && ranks.rapid_protocol >= 0 && ranks.rapid_protocol <= 3)) &&
        (!('reinforced_vest' in ranks) || (ranks.reinforced_vest is int && ranks.reinforced_vest >= 0 && ranks.reinforced_vest <= 3)) &&
        (!('impact_bracing' in ranks) || (ranks.impact_bracing is int && ranks.impact_bracing >= 0 && ranks.impact_bracing <= 3)) &&
        (!('last_reserve' in ranks) || (ranks.last_reserve is int && ranks.last_reserve >= 0 && ranks.last_reserve <= 3)) &&
        (!('light_footwork' in ranks) || (ranks.light_footwork is int && ranks.light_footwork >= 0 && ranks.light_footwork <= 3)) &&
        (!('dynamic_stride' in ranks) || (ranks.dynamic_stride is int && ranks.dynamic_stride >= 0 && ranks.dynamic_stride <= 3)) &&
        (!('jump_technique' in ranks) || (ranks.jump_technique is int && ranks.jump_technique >= 0 && ranks.jump_technique <= 3)) &&
        (!('combat_analysis' in ranks) || (ranks.combat_analysis is int && ranks.combat_analysis >= 0 && ranks.combat_analysis <= 3)) &&
        (!('cooldown_planning' in ranks) || (ranks.cooldown_planning is int && ranks.cooldown_planning >= 0 && ranks.cooldown_planning <= 3)) &&
        (!('field_intelligence' in ranks) || (ranks.field_intelligence is int && ranks.field_intelligence >= 0 && ranks.field_intelligence <= 3)) &&
        stats is map &&
        stats.keys().hasAll(['survivalRuns', 'pvpMatches', 'pvpWins', 'survivalKills', 'pvpDamage', 'bossesDefeated']) &&
        stats.keys().hasOnly(['survivalRuns', 'pvpMatches', 'pvpWins', 'survivalKills', 'pvpDamage', 'bossesDefeated']) &&
        stats.survivalRuns is int && stats.survivalRuns >= 0 && stats.survivalRuns <= 10000000 &&
        stats.pvpMatches is int && stats.pvpMatches >= 0 && stats.pvpMatches <= 10000000 &&
        stats.pvpWins is int && stats.pvpWins >= 0 && stats.pvpWins <= 10000000 &&
        stats.survivalKills is int && stats.survivalKills >= 0 && stats.survivalKills <= 100000000 &&
        stats.pvpDamage is int && stats.pvpDamage >= 0 && stats.pvpDamage <= 1000000000 &&
        stats.bossesDefeated is int && stats.bossesDefeated >= 0 && stats.bossesDefeated <= 10000000;
    }

    // Test connection probe
    match /test/{document} {
      allow read: if isSignedIn();
    }

    // Public game leaderboard. Entries are immutable after submission.
    match /leaderboard/{scoreId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(scoreId) && isValidLeaderboardEntry(request.resource.data);
      allow update, delete: if false;
    }

    // Player profiles and personal records
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Private account progression. A player may only read/write their own profile.
    match /users/{userId}/gameData/{documentId} {
      allow read: if isSignedIn() &&
        request.auth.uid == userId &&
        documentId == 'accountProgression';
      allow create, update: if isSignedIn() &&
        request.auth.uid == userId &&
        documentId == 'accountProgression' &&
        isValidAccountProgressionDocument(request.resource.data);
      allow delete: if false;
    }

    // Default deny for unmatched documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
