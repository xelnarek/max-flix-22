{
  "name": "paleciaki-magazyn-chaosu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "android:setup": "npm install --no-save --package-lock=false @capacitor/core@8.6.0 @capacitor/cli@8.6.0 @capacitor/android@8.6.0 @capacitor/assets@3.0.5 && npx cap add android",
    "android:sync": "npm install --no-save --package-lock=false @capacitor/core@8.6.0 @capacitor/cli@8.6.0 @capacitor/android@8.6.0 @capacitor/assets@3.0.5 && npm run build && npx cap sync android && npx capacitor-assets generate --android",
    "android:open": "npx cap open android",
    "android:prepare-release": "node scripts/prepare-android-release.mjs"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "esbuild@0.25.12": true,
    "protobufjs@7.6.6": true
  },
  "dependencies": {
    "@pmndrs/uikit": "^1.0.64",
    "@preact/signals-core": "^1.14.0",
    "firebase": "^13.1.0",
    "lit": "^3.3.1",
    "three": "~0.186.0",
    "tslib": "^2.8.1",
    "xrblocks": "~0.24.0",
    "@capacitor-community/admob": "8.2.1"
  },
  "devDependencies": {
    "@types/dom-speech-recognition": "^0.0.7",
    "@types/node": "^25.0.8",
    "@types/three": "^0.186.0",
    "@types/webxr": "^0.5.24",
    "typescript": "^6.0.3",
    "vite": "^6.2.3"
  }
}
